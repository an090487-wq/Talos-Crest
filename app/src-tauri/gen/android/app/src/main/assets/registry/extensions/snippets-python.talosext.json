{
  "id": "snippets-python",
  "name": "Python Snippets",
  "kind": "snippets",
  "version": "1.0.0",
  "author": "Talos Community",
  "publisher": "Talos Community",
  "description": "Free, MIT-licensed snippets for Python: functions, classes, comprehensions, context managers, and tests.",
  "license": "MIT",
  "snippets": [
    {
      "prefix": "main",
      "label": "__main__ guard",
      "description": "Script entry point",
      "body": "if __name__ == \"__main__\":\n    ${0:pass}",
      "languages": [
        "python",
        "py",
        "Python"
      ]
    },
    {
      "prefix": "def",
      "label": "def ...",
      "description": "Function with docstring",
      "body": "def ${1:name}(${2:args}):\n    \"\"\"${3:docstring}\"\"\"\n    ${0:pass}",
      "languages": [
        "python",
        "py",
        "Python"
      ]
    },
    {
      "prefix": "class",
      "label": "class ...",
      "description": "Class with initializer",
      "body": "class ${1:Name}:\n    def __init__(self, ${2:args}):\n        ${0:pass}",
      "languages": [
        "python",
        "py",
        "Python"
      ]
    },
    {
      "prefix": "for",
      "label": "for ... in",
      "description": "For loop",
      "body": "for ${1:item} in ${2:items}:\n    ${0:pass}",
      "languages": [
        "python",
        "py",
        "Python"
      ]
    },
    {
      "prefix": "with",
      "label": "with open(...)",
      "description": "Context-managed file read",
      "body": "with open(${1:path}, \"${2:r}\") as ${3:f}:\n    ${0:content} = ${3:f}.read()",
      "languages": [
        "python",
        "py",
        "Python"
      ]
    },
    {
      "prefix": "try",
      "label": "try/except/finally",
      "description": "Exception handling",
      "body": "try:\n    ${1:pass}\nexcept ${2:Exception} as ${3:error}:\n    ${4:pass}\nfinally:\n    ${0:pass}",
      "languages": [
        "python",
        "py",
        "Python"
      ]
    },
    {
      "prefix": "list",
      "label": "list comprehension",
      "description": "List comprehension",
      "body": "${1:result} = [${2:expr} for ${3:item} in ${4:items} if ${0:condition}]",
      "languages": [
        "python",
        "py",
        "Python"
      ]
    },
    {
      "prefix": "test",
      "label": "pytest function",
      "description": "Pytest test case",
      "body": "def test_${1:name}():\n    ${2:result} = ${3:call()}\n    assert ${0:result} == ${4:expected}",
      "languages": [
        "python",
        "py",
        "Python"
      ]
    }
  ]
}
